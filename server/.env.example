# ============================================================
# PayLens — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# ============================================================

# Server
PORT=3001

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DEFAULT_MERCHANT_ID=your-supabase-merchant-uuid

# CORS (optional, defaults to http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------
# The following keys will be added in later phases:
# -----------------------------------------------------------

# Razorpay (Phase 2 — Webhook & Payment Links)
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Google Gemini AI (Phase 3 — AI Failure Analysis)
# GEMINI_API_KEY=your-gemini-api-key
